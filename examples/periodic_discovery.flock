                "COMMENT": {
                  "shadow": {
                    "type": "text_multiline",
                    "id": "ml-pt-0034",
                    "fields": {
                      "TEXT": "PubChem's periodic table data lists aluminium and calcium as ancient, but its element pages say aluminium was first isolated in 1825 and calcium in 1808 (https://pubchem.ncbi.nlm.nih.gov/element/13 and https://pubchem.ncbi.nlm.nih.gov/element/20). We use those years instead."
                    }
                  }
                }
