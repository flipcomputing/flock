                          "shadow": {
                            "type": "text_multiline",
                            "id": "2B+zNZ|`V4(5pFCiRc;,",
                            "fields": {
                              "TEXT": "How often each letter is used in English text, as a percentage. Each letter is stretched upwards in proportion to its frequency. Letters used less than 0.5% of the time lie flat, and their thickness shows the frequency. Each letter has an invisible box around it, so you can click near a letter to see its frequency. Click Sort by frequency or Sort A to Z to change the order of the letters. Vowels are orange and consonants are blue. Use the arrow keys or the on-screen pad to move the camera."
                            }
                          }
                        }
