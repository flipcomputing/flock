{
  "type": "when_clicked",
  "extraState": "<mutation xmlns=\"http://www.w3.org/1999/xhtml\" inline=\"false\"></mutation>",
  "fields": {
    "MODEL_VAR": { "name": "star1", "type": "" },
    "TRIGGER": "OnPickTrigger"
  },
  "inputs": {
    "DO": {
      "block": {
        "type": "math_change",
        "fields": { "VAR": { "name": "clicks", "type": "" } },
        "inputs": { "DELTA": { "shadow": { "type": "math_number", "fields": { "NUM": 1 } } } },
        "next": {
          "block": {
            "type": "print_text",
            "inputs": {
              "TEXT": {
                "shadow": { "type": "text", "fields": { "TEXT": "" } },
                "block": { "type": "variables_get", "fields": { "VAR": { "name": "clicks", "type": "" } } }
              },
              "DURATION": { "shadow": { "type": "math_number", "fields": { "NUM": 30 } } },
              "COLOR": { "shadow": { "type": "colour", "fields": { "COLOR": "#000080" } } }
            }
          }
        }
      }
    }
  }
}
